# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code settings
.claude/

# large GIS source datasets (not needed for app runtime)
HydroRIVERS_v10_as_shp/
kazakhstan-260513-free/

# cached Sentinel satellite image (regenerated on demand, always overwritten)
/.cache/

# terrain tiles (large binary, built once locally — see data/README if regenerating)
/data/*.mbtiles
